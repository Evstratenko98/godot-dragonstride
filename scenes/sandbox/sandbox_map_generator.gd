	{"name": "SemanticBridge", "tile_set_key": "bridge", "parent": "topology", "placement": "semantic", "visible": false, "z_index": 0, "packed_cells": "AAAJAAQAAQAAAAIAAAAJAAUAAQAAAAIAAAAJAAYAAQAAAAMAAAAJAAMAAQAAAAIAAAAJAAIAAQAAAAEAAAA="},
	{"name": "Water", "tile_set_key": "water", "parent": "level", "placement": "terrain", "visible": true, "z_index": 0, "packed_cells": ""},
