	{"name": "Hay", "tile_set_key": "hay", "parent": "level", "placement": "terrain", "visible": true, "z_index": 0, "packed_cells": "AAAJAAEAAAAGAAEAAAAKAAEAAAAHAAEAAAAKAAIAAAAHAAIAAAAIAAEAAAAFAAEAAAAIAAAAAAAFAAAAAAAJAAAAAAAGAAAAAAAKAAAAAAAHAAAAAAAJAAIAAAAGAAIAAAAIAAIAAAAFAAIAAAA="},
	{"name": "Bridge", "tile_set_key": "bridge", "parent": "level", "placement": "terrain", "visible": true, "z_index": 0, "packed_cells": "AAAJAAQAAQAAAAIAAAAJAAUAAQAAAAIAAAAJAAYAAQAAAAMAAAAJAAMAAQAAAAIAAAAJAAIAAQAAAAEAAAA="},
	{"name": "Clouds", "tile_set_key": "clouds", "parent": "level", "placement": "overlay", "visible": true, "z_index": 0, "packed_cells": "AAD+////AAAAAAAAAAD/////AAABAAAAAAABAP//AAAAAAAAAAACAP//AAABAAAAAAAFAAAAAAAAAAAAAAAGAAAAAAABAAAAAAD9/wEAAAAAAAAAAAD+/wEAAAABAAAAAAAEAAUAAAAAAAAAAAAFAAUAAAABAAAAAAD//wQAAAAAAAAAAAAAAAQAAAABAAAAAAAEAAIAAAAAAAAAAAAFAAIAAAABAAAAAAA="},
	{"name": "test", "tile_set_key": "platform", "parent": "level", "placement": "overlay", "visible": true, "z_index": 20, "packed_cells": ""},
]


static func generate(seed: int = FIXED_SEED) -> WorldMapDocument:
	var document: WorldMapDocument = WorldMapDocument.new()
	document.schema_version = NetworkProtocol.MAP_SCHEMA_VERSION
	document.level_id = LevelCatalog.SANDBOX_LEVEL_ID
	document.generator_id = "sandbox"
	document.generator_version = GENERATOR_VERSION
	document.seed = seed
	document.grid_size = Vector2i(19, 19)
	for recipe_value: Variant in LAYER_RECIPES:
		var recipe: Dictionary = recipe_value as Dictionary
		document.layers.append(_create_layer_record(recipe))
	document.surface_layers = _create_surface_layers()
	document.ramps = _create_ramps()
	document.player_spawn_surfaces = [
		Vector3i(5, 0, 0),
		Vector3i(6, 0, 0),
		Vector3i(9, 0, 0),
		Vector3i(10, 0, 0),
		Vector3i(5, 2, 0),
		Vector3i(6, 2, 0),
		Vector3i(9, 2, 0),
		Vector3i(10, 2, 0),
	]
	document.static_entities = [
		_create_placement("sheep", "Sheep3", "Sheep3", Vector2(287, 350), Vector2.ONE, 0),
		_create_placement("warrior", "Warrior", "Warrior", Vector2(94, 340), Vector2.ONE, 0),
	]
	document.static_objects = [
		_create_placement("house", "house_1", "House", Vector2(92, 214), Vector2(1.2, 1.2), 0),
		_create_placement("tree", "tree_2", "Tree2", Vector2(353, 225), Vector2.ONE, 0),
		_create_placement("chest", "chest_1", "Chest", Vector2(608, 672), Vector2.ONE, 0),
		_create_placement("vision_tower", "vision_tower_1", "VisionTower", Vector2(288, 608), Vector2.ONE, 1),
		_create_placement("healing_well", "healing_well_1", "HealingWell", Vector2(224, 480), Vector2.ONE, 0),
		_create_placement("linked_portal", "linked_portal_1", "LinkedPortal1", Vector2(544, 480), Vector2.ONE, 0),
		_create_placement("linked_portal", "linked_portal_2", "LinkedPortal2", Vector2(992, 864), Vector2.ONE, 0),
	]
	return document


static func _create_layer_record(recipe: Dictionary) -> Dictionary:
	return {
		"name": str(recipe.get("name", "")),
		"tile_set_key": str(recipe.get("tile_set_key", "")),
		"parent": str(recipe.get("parent", "")),
		"placement": str(recipe.get("placement", "")),
		"visible": bool(recipe.get("visible", true)),
		"z_index": int(recipe.get("z_index", 0)),
		"cells": _decode_cells(str(recipe.get("packed_cells", ""))),
	}


static func _decode_cells(encoded_data: String) -> Array:
	var cells: Array = []
	var packed_data: PackedByteArray = Marshalls.base64_to_raw(encoded_data)
	if packed_data.size() < PACKED_HEADER_BYTES:
		return cells
	if (packed_data.size() - PACKED_HEADER_BYTES) % PACKED_CELL_BYTES != 0:
		return cells
	var offset: int = PACKED_HEADER_BYTES
	while offset < packed_data.size():
		cells.append([
			_read_int16(packed_data, offset),
			_read_int16(packed_data, offset + 2),
			_read_int16(packed_data, offset + 4),
			_read_int16(packed_data, offset + 6),
			_read_int16(packed_data, offset + 8),
			_read_int16(packed_data, offset + 10),
		])
		offset += PACKED_CELL_BYTES
	return cells


static func _read_int16(data: PackedByteArray, offset: int) -> int:
	var value: int = int(data[offset]) | (int(data[offset + 1]) << 8)
	return value - 65_536 if value >= 32_768 else value


static func _create_surface_layers() -> Array[Dictionary]:
	var excluded_cells: Array = [
		[3, 9], [4, 9], [5, 9],
		[3, 10], [4, 10], [5, 10],
		[3, 11], [4, 11], [5, 11],
		[2, 9], [2, 11], [6, 9], [6, 11],
	]
	return [
		_create_surface_layer("SurfaceH0Ground", "SemanticGround", 0, [], excluded_cells, false, "ground"),
		_create_surface_layer("SurfaceH0Hay", "SemanticHay", 0, [], excluded_cells, true, "hay"),
		_create_surface_layer("SurfaceH0Bridge", "SemanticBridge", 0, [], [], true, "bridge"),
		_create_surface_layer("SurfaceH1Platform", "", 1, [
			[3, 8], [4, 8], [5, 8],
			[3, 9], [4, 9], [5, 9],
			[3, 10], [4, 10], [5, 10],
		], [], false, "platform H1"),
	]


static func _create_surface_layer(
	node_name: String,
	source_layer: String,
	elevation: int,
	explicit_cells: Array,
	excluded_cells: Array,
	is_character_only: bool,
	display_name: String
) -> Dictionary:
	return {
		"node_name": node_name,
		"source_layer": source_layer,
		"elevation": elevation,
		"explicit_cells": explicit_cells.duplicate(true),
		"excluded_cells": excluded_cells.duplicate(true),
		"character_only": is_character_only,
		"display_name": display_name,
	}


static func _create_ramps() -> Array[Dictionary]:
	return [
		_create_ramp("RampLeftTop", "sandbox_left_top", [1, 9, 0], [3, 8, 1], [1, 0], [-1, 0], [[2, 8], [2, 9]], [[2, 9]]),
		_create_ramp("RampLeftBottom", "sandbox_left_bottom", [1, 11, 0], [3, 10, 1], [1, 0], [-1, 0], [[2, 10], [2, 11]], [[2, 11]]),
		_create_ramp("RampRightTop", "sandbox_right_top", [7, 9, 0], [5, 8, 1], [-1, 0], [1, 0], [[6, 8], [6, 9]], [[6, 9]]),
		_create_ramp("RampRightBottom", "sandbox_right_bottom", [7, 11, 0], [5, 10, 1], [-1, 0], [1, 0], [[6, 10], [6, 11]], [[6, 11]]),
	]


static func _create_ramp(
	node_name: String,
	connection_id: String,
	low_surface: Array,
	high_surface: Array,
	low_direction: Array,
	high_direction: Array,
	visual_footprint: Array,
	blocked_lower_cells: Array
) -> Dictionary:
	return {
		"node_name": node_name,
		"connection_id": connection_id,
		"low_surface": low_surface,
		"high_surface": high_surface,
		"low_input_direction": low_direction,
		"high_input_direction": high_direction,
		"visual_footprint": visual_footprint,
		"blocked_lower_cells": blocked_lower_cells,
		"traversal_kind": WorldRampConnection.TraversalKind.RAMP,
	}


static func _create_placement(
	type_key: String,
	item_id: String,
	node_name: String,
	position: Vector2,
	scale: Vector2,
	surface_height: int
) -> Dictionary:
	return {
		"type_key": type_key,
		"id": item_id,
		"node_name": node_name,
		"position": [position.x, position.y],
		"scale": [scale.x, scale.y],
		"surface_height": surface_height,
	}

