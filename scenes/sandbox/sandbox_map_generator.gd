class_name SandboxMapGenerator
extends RefCounted

const FIXED_SEED: int = 1
const GENERATOR_VERSION: int = 2
const PACKED_HEADER_BYTES: int = 2
const PACKED_CELL_BYTES: int = 12
const LAYER_RECIPES := [
